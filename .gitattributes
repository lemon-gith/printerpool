# Shell scripts and files used inside Linux containers must keep LF line endings, even when checked out on
# Windows (Git's autocrlf would otherwise turn them into CRLF, and they'd fail to run).
*.sh            text eol=lf
Dockerfile      text eol=lf
*.py            text eol=lf
*.toml          text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
*.conf          text eol=lf
# PowerShell scripts are for Windows.
*.ps1           text eol=crlf
