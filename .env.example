# Copy to .env and fill in. Never commit .env.

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
# Comma-separated hostnames the site is served on
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins (scheme + host) used for CSRF checks, e.g. https://print.example.ac.uk
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Set to 1 once the site is served over HTTPS (marks cookies Secure, trusts the proxy's X-Forwarded-Proto)
DJANGO_SECURE=0

POSTGRES_DB=printpool
POSTGRES_USER=printpool
POSTGRES_PASSWORD=change-me-too

# Host port the app is published on. Behind Caddy, use 127.0.0.1:8000 so the app is only reachable via the proxy.
APP_PORT=8000
# Only used by the optional Caddy proxy (docker compose --profile proxy up)
SITE_DOMAIN=localhost
# Reverse proxies in front of the app: 1 when using Caddy (with APP_PORT=127.0.0.1:8000), 0 when not.
# Lets login throttling see real visitor IPs. Never set it while the app port is publicly reachable.
DJANGO_TRUSTED_PROXY_COUNT=0

# Default monthly cap in grams of filament for regular users (per-user override in admin)
PRINT_CAP_GRAMS_PER_MONTH=500
# Upload limits
MAX_UPLOAD_MB=50

# Optional contact addresses shown as mailto: links (leave blank to hide).
# Everyone sees "Contact staff"; staff and admins also see "Contact an admin".
CONTACT_STAFF_EMAIL=
CONTACT_ADMIN_EMAIL=

# Public address of the site, used for links in emails
DJANGO_SITE_URL=http://localhost:8000

# Outgoing email for verification codes and opt-in notifications.
# Leave EMAIL_HOST blank to print emails to the app log instead (docker compose logs app).
# Resend: host smtp.resend.com, user "resend", password = your Resend API key (re_...).
# Use port 587 (STARTTLS): Hetzner blocks outgoing 25 and 465 on new accounts.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=
# Must be on the domain you verified with Resend
DEFAULT_FROM_EMAIL=PrintPool <printpool@send.example.ac.uk>
