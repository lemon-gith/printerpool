# Scheduled jobs, in /etc/cron.d format (minute hour day month weekday USER command).
# deploy/setup-server.sh and deploy/update.sh install this as /etc/cron.d/printpool, replacing
# /opt/printerpool with the repo's real location. Times are server time; minutes are deliberately off the hour.
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Delete expired model files (hourly)
17 * * * *  root  /opt/printerpool/deploy/purge.sh >> /var/log/printpool-purge.log 2>&1

# Nightly database dump kept on this server (03:23)
23 3 * * *  root  /opt/printerpool/deploy/backup.sh >> /var/log/printpool-backup.log 2>&1

# Weekly off-site copy of the newest dump (Sundays 04:41)
41 4 * * 0  root  /opt/printerpool/deploy/offsite.sh >> /var/log/printpool-backup.log 2>&1
