# Settings for the host's cron jobs (purge, backup, offsite). Copy to deploy/jobs.env (git-ignored) and fill in.
# Shell syntax: no spaces around '=', quote values with spaces.

# Where nightly dumps are kept on this server, and for how long
BACKUP_DIR=/var/backups/printpool
BACKUP_KEEP_DAYS=14

# --- Weekly off-site copy: fill in one or both ---

# Over SSH (scp). The key should be a dedicated key used only for this, readable only by root (chmod 600).
#OFFSITE_SSH_TARGET=backup@my-server.example.com:/srv/backups/printpool
#OFFSITE_SSH_KEY=/root/.ssh/printpool_backup
#OFFSITE_SSH_PORT=22

# Over HTTPS: each file is uploaded with PUT to $OFFSITE_HTTP_URL/<filename>, with "Authorization: Bearer <key>".
#OFFSITE_HTTP_URL=https://my-server.example.com/backups/printpool
#OFFSITE_API_KEY=

# --- Job monitoring (optional) ---
# A "ping" URL per job from Healthchecks.io (free) or similar. Each run reports start, success or failure,
# and the service alerts you if a job fails or doesn't run on schedule. Set the expected schedule there to
# match deploy/crontab.example (hourly / daily / weekly) with some grace time.
#PURGE_PING_URL=https://hc-ping.com/your-uuid
#BACKUP_PING_URL=https://hc-ping.com/your-uuid
#OFFSITE_PING_URL=https://hc-ping.com/your-uuid
